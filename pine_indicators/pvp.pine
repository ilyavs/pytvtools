//@version=6
// Periodic Volume Profile — completed-period POC lines at period boundaries.
// Uses request.security_lower_tf(LOWER_TF) for lower-TF bars, builds
// a volume histogram per period, draws completed-period POCs via line.new.
//
// Parity vs built-in PVP (BATS:GME, 60m, Total volume, 24 rows):
//   Period 1D: 39/55 (70.9%) — 16 mismatches, all <0.85% delta.  Bar-level
//     data (10m LTF) vs built-in tick-level data limits precision.
//   Period 1W: 20/22 (90.9%) — 2 mismatches, both <0.2% delta.
//   Period 1M:  6/6  (100%) — perfect match.
//   See pvp_gme_60.txt, pvp_gme_60_1w.txt, pvp_gme_60_1m.txt for full reports.
//   Longer periods average out the bar-level noise, improving parity.
//
// Key fix (n_levels): volume per tick level = bar_volume / (n_ticks + 1),
//   NOT bar_volume / n_ticks.  The +1 accounts for the inclusive range
//   [low, low+1tick, ..., high] which spans nt+1 levels.
//
// Pine v6: always array.concat() for LTF arrays, never push() in a loop.
//
// Rendering cap: TV renders at most 50 line.new objects per indicator
// regardless of max_poc_lines. max_poc_lines controls how many lines
// we store (old ones get deleted first-in-first-out).
indicator(title="Periodic Volume Profile (Custom)", shorttitle="PVP_Custom", overlay=true, format=format.price, precision=2)

period_mult   = input.int(1, "Period Multiplier", group="Period")
period_unit   = input.string("Day", "Period Unit", options=["Day", "Week", "Month"], group="Period")
num_rows      = input.int(24, "Number of Rows", group="Rows", minval=1)

max_poc_lines = input.int(200, "Max POC Lines", minval=1, maxval=500, group="Display")
poc_color     = input.color(#64B5F6, "POC Line Color", group="Display")
poc_width     = input.int(1, "POC Line Width", minval=1, maxval=5, group="Display")
poc_style_str = input.string("Solid", "POC Line Style", options=["Solid", "Dashed", "Dotted"], group="Display")
show_poc      = input.bool(true, "Show POC Lines", group="Display")

f_poc_style(s) =>
    switch s
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted

poc_style = f_poc_style(poc_style_str)

f_lower_tf() =>
    int min = int(timeframe.in_seconds(timeframe.period) / 60)
    if min <= 15
        "1"
    else if min <= 30
        "5"
    else if min <= 60
        "10"
    else if min <= 120
        "15"
    else if min <= 240
        "30"
    else
        "60"

LOWER_TF = f_lower_tf()
year_change = ta.change(time("12M"))

f_period_tf() =>
    string base = switch period_unit
        "Day"   => "D"
        "Week"  => "W"
        "Month" => "M"
    period_mult == 1 ? base : str.tostring(period_mult) + base

[hs, ls, vs] = request.security_lower_tf(syminfo.tickerid, LOWER_TF, [high, low, volume])

var float[]   period_highs      = na
var float[]   period_lows       = na
var float[]   period_volumes    = na
var int       period_start_bar  = na
var line[]    poc_lines         = array.new<line>()
var bool[]    poc_active        = array.new<bool>()
var int[]     poc_period        = array.new<int>()

tf_change = ta.change(time(f_period_tf()))
is_new_period = (not na(period_start_bar) and tf_change != 0) or (not na(period_start_bar) and year_change != 0)

if array.size(poc_lines) > 0
    for j = 0 to array.size(poc_lines) - 1
        if array.get(poc_active, j)
            int ps = array.get(poc_period, j)
            if bar_index > ps
                line l = array.get(poc_lines, j)
                float poc_price = line.get_price(l, bar_index)
                if not na(poc_price) and not na(high) and not na(low)
                    if high >= poc_price and low <= poc_price
                        line.set_x2(l, bar_index[1])
                        array.set(poc_active, j, false)
                    else
                        line.set_x2(l, bar_index)

f_poc(lows, highs, vols, rows) =>
    float mt = syminfo.mintick
    float min_p = array.min(lows)
    float max_p = array.max(highs)
    float pr = max_p - min_p
    float result = na
    if pr > 0
        float ticks = pr / mt
        int tpr_down = int(math.floor(ticks / rows))
        int tpr_up = int(math.ceil(ticks / rows))
        tpr_down := math.max(tpr_down, 1)
        tpr_up := math.max(tpr_up, 1)
        int rows_down = int(math.ceil(ticks / tpr_down))
        int rows_up = int(math.ceil(ticks / tpr_up))
        int tpr_used = math.abs(rows_down - rows) <= math.abs(rows_up - rows) ? tpr_down : tpr_up
        int total = int(math.ceil(ticks / tpr_used))
        float ts = tpr_used * mt

        float[] rv = array.new<float>(total, 0.0)
        int sz = array.size(vols)
        for i = 0 to sz - 1
            float bv = array.get(vols, i)
            if na(bv) or bv <= 0
                continue
            float bh = array.get(highs, i)
            float bl = array.get(lows, i)
            float tr = (bh - bl) / mt
            int nt = int(tr)
            nt := math.max(nt, 1)
            int n_levels = nt + 1
            float vpt = bv / n_levels
            for t = 0 to nt
                float price = bl + t * mt
                int r = int(math.floor((price - min_p) / ts))
                r := math.max(0, math.min(total - 1, r))
                float cur = array.get(rv, r)
                array.set(rv, r, cur + vpt)
        float maxv = array.max(rv)
        if maxv > 0
            int idx = array.indexof(rv, maxv)
            if idx == -1
                idx := 0
            result := min_p + (idx + 0.5) * ts
    result

if is_new_period and not na(period_start_bar) and not na(period_highs) and array.size(period_highs) > 0
    float poc_price = f_poc(period_lows, period_highs, period_volumes, num_rows)
    if not na(poc_price) and show_poc
        if array.size(poc_lines) >= max_poc_lines
            line.delete(array.shift(poc_lines))
            array.shift(poc_active)
            array.shift(poc_period)
        line l = line.new(bar_index[1], poc_price, bar_index, poc_price, xloc=xloc.bar_index, extend=extend.none, color=poc_color, style=poc_style, width=poc_width)
        array.push(poc_lines, l)
        array.push(poc_active, true)
        array.push(poc_period, period_start_bar)

if is_new_period or na(period_start_bar)
    period_start_bar := bar_index
    period_highs := array.copy(hs)
    period_lows  := array.copy(ls)
    period_volumes := array.copy(vs)
else
    period_highs   := array.concat(period_highs, hs)
    period_lows    := array.concat(period_lows, ls)
    period_volumes := array.concat(period_volumes, vs)

plot(is_new_period ? 1.0 : na, "Period Marker", display=display.all)
