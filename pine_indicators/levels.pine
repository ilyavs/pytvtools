//@version=6
indicator(title="Multi-Period Close Levels", shorttitle="CL_Levels", overlay=true, format=format.price, precision=2)

delete_on_cross = input.bool(false, "Delete on Cross", group="Line Handling")
max_lines       = input.int(200, "Max Lines", minval=1, maxval=500, group="Line Handling")

f_style(s) =>
    switch s
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted

mult1  = input.int(1, "Multiplier", group="Period 1")
unit1  = input.string("D", "Unit", options=["D", "W", "M"], group="Period 1")
en1    = input.bool(true, "Enabled", group="Period 1")
col1   = input.color(#64B5F6, "Line Color", group="Period 1")
sty1   = input.string("Solid", "Line Style", options=["Solid", "Dashed", "Dotted"], group="Period 1")
w1     = input.int(1, "Line Width", minval=1, maxval=5, group="Period 1")
p1  = mult1 > 1 ? str.tostring(mult1) + unit1 : unit1
var line[]   s1_lines  = array.new<line>()
var bool[]   s1_active = array.new<bool>()
var float[]  s1_prices = array.new<float>()
var float     c1        = na

mult2  = input.int(1, "Multiplier", group="Period 2")
unit2  = input.string("W", "Unit", options=["D", "W", "M"], group="Period 2")
en2    = input.bool(true, "Enabled", group="Period 2")
col2   = input.color(#FF7043, "Line Color", group="Period 2")
sty2   = input.string("Solid", "Line Style", options=["Solid", "Dashed", "Dotted"], group="Period 2")
w2     = input.int(1, "Line Width", minval=1, maxval=5, group="Period 2")
p2  = mult2 > 1 ? str.tostring(mult2) + unit2 : unit2
var line[]   s2_lines  = array.new<line>()
var bool[]   s2_active = array.new<bool>()
var float[]  s2_prices = array.new<float>()
var float     c2        = na

mult3  = input.int(1, "Multiplier", group="Period 3")
unit3  = input.string("M", "Unit", options=["D", "W", "M"], group="Period 3")
en3    = input.bool(true, "Enabled", group="Period 3")
col3   = input.color(#66BB6A, "Line Color", group="Period 3")
sty3   = input.string("Solid", "Line Style", options=["Solid", "Dashed", "Dotted"], group="Period 3")
w3     = input.int(1, "Line Width", minval=1, maxval=5, group="Period 3")
p3  = mult3 > 1 ? str.tostring(mult3) + unit3 : unit3
var line[]   s3_lines  = array.new<line>()
var bool[]   s3_active = array.new<bool>()
var float[]  s3_prices = array.new<float>()
var float     c3        = na

mult4  = input.int(2, "Multiplier", group="Period 4")
unit4  = input.string("D", "Unit", options=["D", "W", "M"], group="Period 4")
en4    = input.bool(false, "Enabled", group="Period 4")
col4   = input.color(#FFA726, "Line Color", group="Period 4")
sty4   = input.string("Solid", "Line Style", options=["Solid", "Dashed", "Dotted"], group="Period 4")
w4     = input.int(1, "Line Width", minval=1, maxval=5, group="Period 4")
p4  = mult4 > 1 ? str.tostring(mult4) + unit4 : unit4
var line[]   s4_lines  = array.new<line>()
var bool[]   s4_active = array.new<bool>()
var float[]  s4_prices = array.new<float>()
var float     c4        = na

mult5  = input.int(5, "Multiplier", group="Period 5")
unit5  = input.string("D", "Unit", options=["D", "W", "M"], group="Period 5")
en5    = input.bool(false, "Enabled", group="Period 5")
col5   = input.color(#AB47BC, "Line Color", group="Period 5")
sty5   = input.string("Solid", "Line Style", options=["Solid", "Dashed", "Dotted"], group="Period 5")
w5     = input.int(1, "Line Width", minval=1, maxval=5, group="Period 5")
p5  = mult5 > 1 ? str.tostring(mult5) + unit5 : unit5
var line[]   s5_lines  = array.new<line>()
var bool[]   s5_active = array.new<bool>()
var float[]  s5_prices = array.new<float>()
var float     c5        = na

f_check_lines(la, active, prices) =>
    int size = array.size(la)
    if size > 0
        for j = 0 to size - 1
            if array.get(active, j)
                px = array.get(prices, j)
                if not na(px) and not na(high) and not na(low)
                    if high >= px and low <= px
                        if delete_on_cross
                            line.delete(array.get(la, j))
                        else
                            line.set_x2(array.get(la, j), bar_index[1])
                        array.set(active, j, false)
                    else
                        line.set_x2(array.get(la, j), bar_index)

f_new_line(la, active, prices, price, line_color, style, width, trigger) =>
    if trigger and not na(price)
        while array.size(la) >= max_lines
            line.delete(array.shift(la))
            array.shift(active)
            array.shift(prices)
        l = line.new(bar_index[1], price, bar_index, price, xloc=xloc.bar_index, extend=extend.none, color=line_color, style=f_style(style), width=width)
        array.push(la, l)
        array.push(active, true)
        array.push(prices, price)

c1 := request.security(syminfo.tickerid, p1, close)
c2 := request.security(syminfo.tickerid, p2, close)
c3 := request.security(syminfo.tickerid, p3, close)
c4 := request.security(syminfo.tickerid, p4, close)
c5 := request.security(syminfo.tickerid, p5, close)

t1 = ta.change(time(p1)) != 0
t2 = ta.change(time(p2)) != 0
t3 = ta.change(time(p3)) != 0
t4 = ta.change(time(p4)) != 0
t5 = ta.change(time(p5)) != 0

f_check_lines(s1_lines, s1_active, s1_prices)
f_check_lines(s2_lines, s2_active, s2_prices)
f_check_lines(s3_lines, s3_active, s3_prices)
f_check_lines(s4_lines, s4_active, s4_prices)
f_check_lines(s5_lines, s5_active, s5_prices)

f_new_line(s1_lines, s1_active, s1_prices, c1[1], col1, sty1, w1, en1 and t1)
f_new_line(s2_lines, s2_active, s2_prices, c2[1], col2, sty2, w2, en2 and t2)
f_new_line(s3_lines, s3_active, s3_prices, c3[1], col3, sty3, w3, en3 and t3)
f_new_line(s4_lines, s4_active, s4_prices, c4[1], col4, sty4, w4, en4 and t4)
f_new_line(s5_lines, s5_active, s5_prices, c5[1], col5, sty5, w5, en5 and t5)

plot(na, title="dummy")
